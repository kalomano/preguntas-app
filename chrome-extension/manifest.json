{
  "manifest_version": 3,
  "name": "Mis Preguntas — Guardar desde Testazo y Bombea",
  "version": "1.1.0",
  "description": "Guarda una pregunta corregida de Testazo o Bombea en Mis Preguntas, con tema detectado y enlace de origen.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.testazo.com/*",
    "https://testazo.com/*",
    "https://bombea.madrid/*",
    "https://preguntas-app.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.testazo.com/*",
        "https://testazo.com/*",
        "https://bombea.madrid/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://preguntas-app.onrender.com/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
